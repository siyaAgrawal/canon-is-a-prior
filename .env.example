# Optional. If unset, the site stores responses in a local JSON-lines file under ./.data
# (fine for development; use Postgres for a real deployment).
DATABASE_URL=

# Optional. Enables the live AI-evaluation route. Without it, /ai-console is read-only
# and clearly marked as not configured. No results are ever fabricated.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Required to use /api/export (CSV/JSON download of collected responses).
RESEARCH_TOKEN=
